{
  "schema": "kimyolab.host-architecture-audit.v1",
  "semantics": "Static audit of the host boundary (ADR-P2-003). A violation is code outside src/app/host.ts that hard-codes the site root, writes navigation state, or inspects which host it runs in. Logical app routes (/learn/…) passed to link() are the route model, not violations.",
  "hostBoundary": {
    "file": "src/app/host.ts",
    "exists": true,
    "importedBy": [
      "src/app/bootstrap.ts"
    ],
    "onlyBootstrapImports": true,
    "bootstrapUsesHost": {
      "resolveHost": true,
      "contentBase": true,
      "fetchContent": true,
      "storage": true,
      "locks": true,
      "links": true
    }
  },
  "hardcodedPaths": {
    "patterns": [
      {
        "id": "content-root-literal",
        "description": "a content URL hard-coded to /content",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "app-preview-root-literal",
        "description": "a module/CSS URL hard-coded to /app-preview/",
        "allowIn": []
      },
      {
        "id": "asset-root-literal",
        "description": "an asset URL hard-coded to /assets/ or /vendor/",
        "allowIn": []
      },
      {
        "id": "api-root-literal",
        "description": "an API URL hard-coded to /api/",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "location-or-history-write",
        "description": "navigation state written outside the host boundary",
        "allowIn": [
          "src/app/host.ts"
        ]
      },
      {
        "id": "host-type-check",
        "description": "code that inspects which host it runs in",
        "allowIn": [
          "src/app/host.ts"
        ]
      }
    ],
    "after": {
      "byPattern": {
        "content-root-literal": 0,
        "app-preview-root-literal": 0,
        "asset-root-literal": 0,
        "api-root-literal": 0,
        "location-or-history-write": 0,
        "host-type-check": 0
      },
      "violations": 0,
      "findings": []
    },
    "shell": {
      "rootAbsoluteUrlsWhenMountedAtKimyolab": [],
      "declaresBasePath": true,
      "routeAnchors": 6
    }
  },
  "serviceWorker": {
    "registrations": [],
    "maxAllowedScope": "<basePath> (e.g. /kimyolab/)",
    "pass": true
  },
  "storage": {
    "strategy": "namespace from basePath: \"/\" → kimyolab (legacy names kept: kimyolab-runtime, kimyolab.attempt.); \"/kimyolab/\" → kimyolab@/kimyolab/ (kimyolab@/kimyolab/.runtime, kimyolab@/kimyolab/.attempt.)",
    "legacyDefaultParameters": [
      {
        "file": "src/features/progress/liveness.ts",
        "line": 9
      },
      {
        "file": "src/features/progress/service.ts",
        "line": 60
      },
      {
        "file": "src/runtime/progress/indexeddb-store.ts",
        "line": 154
      }
    ],
    "note": "the defaults are the root namespace values used by Node tests; the browser bootstrap always passes the host namespace"
  },
  "css": {
    "selectors": 500,
    "klScoped": 498,
    "rootCustomPropertyBlocks": 2,
    "rootNonNamespacedDeclarations": [],
    "global": []
  },
  "before": null
}
